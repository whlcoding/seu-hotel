# Copy this to .env.docker and fill in APP_KEY
# Generate a key with: php -r "echo 'base64:' . base64_encode(random_bytes(32));"

APP_NAME=SeuHotel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=base64:CHANGE_ME

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=seuhotel
DB_USERNAME=seuhotel
DB_PASSWORD=secret

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=debug
